# Copia este fichero a .env.local y rellena los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.

# ── Base de datos ───────────────────────────────────────────────────────────
# Atlas → Cluster0 → Connect → Drivers. Sustituye <db_password> por la del
# usuario que crees en Database Access. La base es bonsaiartesania y el cluster
# aloja otros proyectos, así que el nombre de la base importa.
MONGODB_URI="mongodb+srv://USUARIO:CONTRASENA@cluster0.XXXXX.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Secreto para firmar cookies de sesión. Genera uno con:  npx auth secret
AUTH_SECRET=""

# URL pública del sitio. En local se puede dejar así; en Vercel se pone
# https://bonsaiartesania.com para que el callback de Google apunte bien.
AUTH_URL="http://localhost:3000"


# ── Panel de gestión (el «taller») ──────────────────────────────────────────
# Correos que pueden entrar en /taller para ver y gestionar pedidos, separados
# por comas. Sin esto, nadie es administrador y el panel devuelve 404.
ADMIN_EMAILS=""

# ── Correo transaccional ────────────────────────────────────────────────────
# SMTP del buzón de IONOS. Sin estas variables la web funciona igual, pero no
# se envían los avisos de pedido (queda un aviso en consola).
SMTP_HOST="smtp.ionos.es"
SMTP_PORT="465"
SMTP_USER="bonsai@bonsaiartesania.com"
SMTP_PASSWORD=""

# ── Interruptor de la tienda ────────────────────────────────────────────────
# "true" abre el carrito y el paso de confirmación. Cualquier otro valor —o
# ausencia— deja el catálogo como escaparate y los encargos se cierran hablando.
#
# Ojo con qué abre: NO es una venta con cobro, es una petición. No hay pasarela,
# así que el flujo no cobra nada y los textos se lo dicen al cliente tal cual
# ("tu petición queda registrada, Ana te escribe"). Se puede tener en "true" en
# producción sin engañar a nadie, pero exige que Ana conteste esos avisos a mano:
# si no, el cliente se queda esperando. Ver lib/shop.ts.
TIENDA_ABIERTA="true"

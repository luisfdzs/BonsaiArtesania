# Copia este fichero a .env.local y rellena los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.

# ── Base de datos ───────────────────────────────────────────────────────────
# Atlas → Cluster0 → Connect → Drivers. Sustituye <db_password> por la del
# usuario que crees en Database Access. La base es bonsaiartesania y el cluster
# aloja otros proyectos, así que el nombre de la base importa.
MONGODB_URI="mongodb+srv://USUARIO:CONTRASENA@cluster0.XXXXX.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

# ── Acceso y sesiones ───────────────────────────────────────────────────────
# Secreto de Auth.js. Genera uno con:  npx auth secret
#
# Obligatorio: además de las cookies de sesión, es la clave del HMAC con el que
# se guardan los códigos de seis cifras del alta y de la recuperación (ver
# lib/codes.ts). Sin él no se puede crear ninguna cuenta.
#
# Cambiarlo invalida los códigos que estuvieran en vuelo —diez minutos como
# mucho— pero NO las contraseñas ni las sesiones abiertas, que no dependen de él.
AUTH_SECRET=""

# URL pública del sitio. En local se puede dejar así.
AUTH_URL="http://localhost:3000"


# ── Panel de gestión (el «taller») ──────────────────────────────────────────
# Correos que pueden entrar en /taller para ver y gestionar pedidos, separados
# por comas. Sin esto, nadie es administrador y el panel devuelve 404.
ADMIN_EMAILS=""

# ── Correo transaccional ────────────────────────────────────────────────────
# SMTP del buzón de IONOS. Sin estas variables la web funciona igual, pero no
# se envían los avisos de pedido (queda un aviso en consola).
SMTP_HOST="smtp.ionos.es"
SMTP_PORT="465"
SMTP_USER="bonsai@bonsaiartesania.com"
SMTP_PASSWORD=""

# ── Aviso a Ana en el móvil ─────────────────────────────────────────────────
# Bot de Telegram que le hace sonar el teléfono al llegar un pedido. El correo
# que recibe el cliente promete ese aviso con esas palabras, así que si esto se
# queda sin rellenar hay que cambiar también el texto de lib/email.ts.
#
# Cómo se sacan los dos valores:
#   1. En Telegram, hablar con @BotFather → /newbot → da el TOKEN.
#   2. Ana abre una conversación con el bot recién creado y le escribe algo
#      (un bot no puede escribir primero a nadie).
#   3. Visitar https://api.telegram.org/bot<TOKEN>/getUpdates y copiar el
#      `chat.id` que aparece ahí.
#
# Sin estas variables la web funciona igual: sólo queda un aviso en consola y
# Ana se entera por el correo a bonsai@.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Interruptor del carrito ─────────────────────────────────────────────────
# "true" abre el carrito y el paso de confirmación. Cualquier otro valor —o
# ausencia— deja el catálogo como escaparate y los encargos se organizan hablando.
#
# Lo que abre es una petición: queda registrada y Ana escribe. Los textos lo dicen
# tal cual, así que se puede tener en "true" en producción sin engañar a nadie,
# pero exige que Ana conteste esos avisos a mano: si no, quien pidió se queda
# esperando. Ver lib/shop.ts.
TIENDA_ABIERTA="true"

# ── Aviso en la app instalada (Web Push) ────────────────────────────────────
# El mismo aviso de pedido que va a Telegram, pero llegando a la app añadida a
# la pantalla de inicio. Se generan una vez con `npm run push:keys` y se pegan
# aquí y en las variables de Vercel; cambiarlas obliga a que cada dispositivo
# vuelva a pulsar «Activar avisos» en /gestion/cuenta.
#
# La pública viaja al navegador —es su cometido—; la privada firma el envío y no
# sale del servidor. Sin ellas la web funciona igual y el aviso sigue yendo por
# Telegram y por correo.
#
# En iPhone sólo funciona si la web está añadida a la pantalla de inicio y se
# abre desde ese icono. En Android y en escritorio no hace falta.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
